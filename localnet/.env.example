
# Bootstrap script will register a subnet, and netuid 1 is preoccupied and unusable, hence we end up with netuid 2
NETUID=2

# Tempo = epoch length in blocks
# This is not configurable yet - support for non-standard tempo is required across the stack
# This only sets the localnet subnet tempo so that it matches the default tempo in other services
SUBNET_TEMPO=360

# Timelocked commit-reveal. Off here: this dev localnet runs fast blocks (~250ms) where pylon's
# commit-reveal timing (which assumes ~12s blocks) misbehaves. Standard 12s-block deployments
# (deploy/linode) set this to true. SUBNET_REVEAL_PERIOD_EPOCHS is the reveal delay in epochs.
SUBNET_COMMIT_REVEAL_ENABLED=false
SUBNET_REVEAL_PERIOD_EPOCHS=1

# Validator connection to pylon
VALIDATOR_PYLON_SERVICE_ADDRESS=http://localhost:8000
VALIDATOR_PYLON_OPEN_ACCESS_TOKEN=localnet-open-access-token
VALIDATOR_PYLON_IDENTITY_NAME=validator
VALIDATOR_PYLON_IDENTITY_TOKEN=localnet-validator-token

# Pretty, colored console logs for local development (production defaults to JSON)
VALIDATOR_LOGGING_FORMAT=console
# Root log level; set to DEBUG for verbose dev logging
VALIDATOR_LOGGING_ROOT_LEVEL=INFO
# Per-logger levels (JSON). Nexus logs every event-bus message at INFO — very noisy; quiet it while
# keeping the validator's own INFO logs (pow.solution / pow.failure / weights).
VALIDATOR_LOGGING_LEVELS={"nexus._internal.core.runtime.event_bus":"WARNING","httpx":"WARNING","httpcore":"WARNING"}
