# Image environment suffix - must match the published image (e.g. refinery-validator-prod).
ENVIRONMENT=prod

# Comma-separated subnets to validate: the NETUIDS line printed by enroll.py on the chain machine.
# The validator hotkey must be registered and staked on every one of them.
NETUIDS=3,5,6

# VLAN IP of the chain machine (subtensor on 9944, archive node on 9945).
CHAIN_VLAN_IP=10.0.0.10

# VLAN IP of THIS validator machine. Miners POST solutions to its port 8001.
VALIDATOR_VLAN_IP=10.0.0.60

# Wallet with the validator hotkey and coldkeypub.txt only (absolute path - compose does not expand ~).
HOST_WALLET_DIR=/home/ubuntu/.bittensor/wallets
BITTENSOR_WALLET_NAME=multi-validator
BITTENSOR_WALLET_HOTKEY_NAME=default

# Pylon access tokens - generate each with: openssl rand -hex 32
VALIDATOR_PYLON_OPEN_ACCESS_TOKEN=
VALIDATOR_PYLON_IDENTITY_TOKEN=

# Nexus logs every event-bus message at INFO; keep the validator's own pow/weights lines only.
VALIDATOR_LOGGING_LEVELS={"nexus._internal.core.runtime.event_bus":"WARNING","httpx":"WARNING","httpcore":"WARNING"}
