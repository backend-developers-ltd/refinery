# Image environment suffix - must match the published image (e.g. refinery-miner-prod).
ENVIRONMENT=prod

# Subnet the miner registers on. Must match the bootstrapped chain (bootstrap creates netuid 2).
NETUID=2

# VLAN IP of the chain machine the miner connects to.
CHAIN_VLAN_IP=10.0.0.10

# VLAN IP of THIS miner machine. Advertised on-chain and used to bind the axon port.
MINER_VLAN_IP=10.0.0.30

# Fixed axon port - published on MINER_VLAN_IP and opened to the validator in the firewall.
MINER_AXON_PORT=18000

# Wallet / instance name (also the on-chain identity) and optional artificial response delay.
MINER_NAME=honest
MINER_RESPONSE_DELAY_S=0
